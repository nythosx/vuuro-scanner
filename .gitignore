# Stack chosen for the Scan Service: plain PHP + SQLite (see
# docs/adr/0001-scan-service-stack.md). Extend further if the stack changes.

# Scan Service local runtime data
scan-service/data/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Env / secrets — never commit these
.env
.env.*
!.env.example

# Common dependency/build dirs (harmless to keep even before a stack is picked)
node_modules/
dist/
build/
.build/
DerivedData/
*.xcuserstate
xcuserdata/
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log

# Local-only planning notes — scratch, not project artifacts, never pushed
WEB_VIEWER_PLAN.md

# Repo policy: only top-level README.md, PHASES.md, and CLAUDE.md are pushed as
# Mark/developer-facing documentation. All other markdown (module READMEs, ADRs,
# status notes) and the web-viewer dev tool stay local-only.
docs/adr/
docs/status/
ios-app/README.md
scan-service/README.md
web-viewer/
