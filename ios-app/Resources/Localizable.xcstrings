                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Scan de kamer rustig"
                    }
                }
            }
        },
        "Pan around all the walls and corners before you leave the room.": {
            "localizations": {
                "en": {
