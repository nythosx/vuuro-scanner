        "Everything captured so far in this room will be lost.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Everything captured so far in this room will be lost."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Alles wat tot nu toe in deze kamer is vastgelegd, gaat verloren."
                    }
                }
            }
        },
        "This room looks larger than RoomPlan's practical scanning range (~9m) — accuracy may degrade beyond this size.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "This room looks larger than RoomPlan's practical scanning range (~9m) — accuracy may degrade beyond this size."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Deze kamer lijkt groter dan het praktische scanbereik van RoomPlan (~9m) — de nauwkeurigheid kan boven deze afmeting afnemen."
                    }
                }
            }
        },
        "Done": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Done"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Klaar"
                    }
                }
            }
        },
        "Scan interrupted": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Scan interrupted"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Scan onderbroken"
                    }
                }
            }
        },
        "Some of this room was captured before the interruption. You can try uploading it as-is, or discard it and scan again.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Some of this room was captured before the interruption. You can try uploading it as-is, or discard it and scan again."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Een deel van deze kamer is vastgelegd voor de onderbreking. Je kunt dit zo uploaden, of het verwijderen en opnieuw scannen."
                    }
                }
            }
        },
        "Upload what was captured": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Upload what was captured"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Upload wat is vastgelegd"
                    }
                }
            }
        },
        "Discard and try again": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Discard and try again"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Verwijderen en opnieuw proberen"
                    }
                }
            }
        },
        "Keep scanning": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Keep scanning"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Blijf scannen"
                    }
                }
            }
        },
        "This room's outline came out too small or flat to use. Try scanning more slowly and cover the whole floor before tapping Done.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "This room's outline came out too small or flat to use. Try scanning more slowly and cover the whole floor before tapping Done."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "De omtrek van deze kamer is te klein of te vlak om te gebruiken. Scan langzamer en dek de hele vloer voordat je op Klaar tikt."
                    }
                }
            }
        },
        "Rescan this room": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Rescan this room"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kamer opnieuw scannen"
                    }
                }
            }
        },
        "Upload didn't go through": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Upload didn't go through"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Uploaden is mislukt"
                    }
                }
            }
        },
        "This room's capture is still on your device. Retry the same upload, or rescan if the room itself needs it.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "This room's capture is still on your device. Retry the same upload, or rescan if the room itself needs it."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "De opname van deze kamer staat nog op je toestel. Probeer dezelfde upload opnieuw, of scan de kamer opnieuw als dat nodig is."
                    }
                }
            }
        },
        "Retry upload": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Retry upload"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Upload opnieuw proberen"
                    }
                }
            }
        },
        "The server rejected this capture's data — retrying the same upload won't change that. Rescanning this room is the way forward.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The server rejected this capture's data — retrying the same upload won't change that. Rescanning this room is the way forward."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "De server heeft de gegevens van deze opname geweigerd — dezelfde upload opnieuw proberen verandert daar niets aan. Deze kamer opnieuw scannen is de juiste vervolgstap."
                    }
                }
            }
        },
        "Scan another room in this unit, or finish and attach photos/notes.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Scan another room in this unit, or finish and attach photos/notes."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Scan nog een kamer in deze eenheid, of rond af en voeg foto's/notities toe."
