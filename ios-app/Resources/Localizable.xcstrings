                        "value": "Tap Save & next"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tik op Opslaan & volgende"
                    }
                }
            }
        },
        "The room is saved on this phone and the next room starts scanning. Keep the camera up while you walk to the next room.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The room is saved on this phone and the next room starts scanning. Keep the camera up while you walk to the next room."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "De kamer wordt op deze telefoon opgeslagen en de volgende kamer wordt gescand. Houd de camera omhoog terwijl je naar de volgende kamer loopt."
                    }
                }
            }
        },
        "Repeat for every room": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Repeat for every room"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Herhaal dit voor elke kamer"
                    }
                }
            }
        },
        "Tap the room counter next to Save & next to see the saved rooms, remove one to rescan it, or delete it.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tap the room counter next to Save & next to see the saved rooms, remove one to rescan it, or delete it."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tik op de kamerteller naast Opslaan & volgende om de opgeslagen kamers te zien, er een te verwijderen om opnieuw te scannen, of te wissen."
                    }
                }
            }
        },
        "Tap Finish in the last room": {
            "localizations": {
