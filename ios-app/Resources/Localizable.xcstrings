                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tik in de laatste kamer op Afronden"
                    }
                }
            }
        },
        "Finish appears once the first room is saved. The room you are scanning is included, then all rooms are merged and uploaded.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Finish appears once the first room is saved. The room you are scanning is included, then all rooms are merged and uploaded."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Afronden verschijnt zodra de eerste kamer is opgeslagen. De kamer die je nu scant telt mee, daarna worden alle kamers samengevoegd en geüpload."
                    }
                }
            }
        },
        "Turn on the lights": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Turn on the lights"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Doe de lichten aan"
                    }
                }
            }
        },
        "Dim rooms, mirrors and glass walls reduce accuracy.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Dim rooms, mirrors and glass walls reduce accuracy."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Donkere kamers, spiegels en glazen wanden verminderen de nauwkeurigheid."
                    }
                }
            }
        },
        "Move slower than feels natural": {
