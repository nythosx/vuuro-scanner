                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Move slower than feels natural"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Beweeg langzamer dan natuurlijk voelt"
                    }
                }
            }
        },
        "Fast pans lose corners and door frames.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Fast pans lose corners and door frames."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Bij snel bewegen worden hoeken en deurkozijnen gemist."
                    }
                }
            }
        },
        "Keep rooms under about 9 m across": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Keep rooms under about 9 m across"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Houd kamers onder ongeveer 9 m breed"
                    }
                }
            }
        },
        "A warning appears on screen when a room gets too big.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A warning appears on screen when a room gets too big."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Er verschijnt een waarschuwing op het scherm als een kamer te groot wordt."
                    }
                }
            }
        },
        "Set the floor": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Set the floor"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Stel de verdieping in"
                    }
                }
            }
        },
        "Tap Set floor at the top of the camera to note which floor the room is on.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tap Set floor at the top of the camera to note which floor the room is on."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tik bovenaan de camera op Verdieping instellen om aan te geven op welke verdieping de kamer ligt."
                    }
                }
            }
        },
        "Need rooms joined into one layout?": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Need rooms joined into one layout?"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kamers samen in één indeling nodig?"
                    }
                }
            }
        },
        "Rooms scanned here are not placed next to each other. Use Scan a whole unit for one connected plan.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Rooms scanned here are not placed next to each other. Use Scan a whole unit for one connected plan."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kamers die je hier scant, worden niet naast elkaar geplaatst. Gebruik Een hele eenheid scannen voor één samenhangende plattegrond."
                    }
                }
            }
        },
        "Set the floor when you change floors": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Set the floor when you change floors"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Stel de verdieping in als je van verdieping wisselt"
                    }
                }
            }
        },
        "Tap Set floor at the top of the camera. It applies to the room you are scanning and the rooms after it, until you change it.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tap Set floor at the top of the camera. It applies to the room you are scanning and the rooms after it, until you change it."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tik bovenaan de camera op Verdieping instellen. Dit geldt voor de kamer die je nu scant en de kamers daarna, totdat je het wijzigt."
                    }
                }
            }
        },
        "Keep the app open while scanning": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Keep the app open while scanning"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Houd de app open tijdens het scannen"
                    }
                }
            }
        },
        "Switching apps or locking the phone can interrupt the room you are scanning.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Switching apps or locking the phone can interrupt the room you are scanning."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Wisselen van app of de telefoon vergrendelen kan de kamer die je scant onderbreken."
                    }
                }
            }
        },
        "Interrupted? Saved rooms are kept": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Interrupted? Saved rooms are kept"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Onderbroken? Opgeslagen kamers blijven bewaard"
                    }
                }
            }
        },
        "Start a whole unit scan again with the same property details, and you can upload the rooms you already saved.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Start a whole unit scan again with the same property details, and you can upload the rooms you already saved."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Start opnieuw een scan van een hele eenheid met dezelfde objectgegevens, dan kun je de al opgeslagen kamers uploaden."
                    }
                }
            }
        },
        "Don't tap Finish before the last room": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Don't tap Finish before the last room"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tik niet op Afronden vóór de laatste kamer"
                    }
                }
            }
        },
        "Finish merges and uploads the unit. To add rooms later, open the scan in History and tap Continue this scan.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Finish merges and uploads the unit. To add rooms later, open the scan in History and tap Continue this scan."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Afronden voegt de eenheid samen en uploadt deze. Wil je later kamers toevoegen, open de scan in Geschiedenis en tik op Deze scan voortzetten."
                    }
                }
            }
        },
        "Don't scan the same room twice": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Don't scan the same room twice"
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Scan dezelfde kamer niet twee keer"
                    }
                }
            }
        },
        "It can create overlapping rooms. To redo a room, remove it first with the retry arrow in the room list.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "It can create overlapping rooms. To redo a room, remove it first with the retry arrow in the room list."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Dat kan overlappende kamers opleveren. Wil je een kamer opnieuw doen, verwijder die dan eerst met de pijl opnieuw proberen in de kamerlijst."
                    }
                }
            }
        },
