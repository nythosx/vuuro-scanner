{
    "sourceLanguage": "en",
    "strings": {
        "%ld room split(s) could not be re-applied because the room changed in this scan (%@). Split the room again if you still need it.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%ld room split(s) could not be re-applied because the room changed in this scan (%@). Split the room again if you still need it."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%ld splitsing(en) konden niet opnieuw worden toegepast omdat de ruimte in deze scan is veranderd (%@). Splits de ruimte opnieuw als dat nog nodig is."
                    }
                }
            }
        },
        "%ld detected item(s) there are removed too. Notes and photos stay with %@.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%ld detected item(s) there are removed too. Notes and photos stay with %@."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%ld gedetecteerde item(s) daar worden ook verwijderd. Notities en foto's blijven bij %@."
                    }
                }
            }
        },
        "Split": {
            "localizations": {
