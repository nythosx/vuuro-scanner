                    }
                }
            }
        },
        "Notes and photos are evidence for each room — condition, damage, or anything worth flagging. They stay attached here and in History; note text and attached photos both print on the PDF export.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Notes and photos are evidence for each room — condition, damage, or anything worth flagging. They stay attached here and in History; note text and attached photos both print on the PDF export."
                    }
                },
                "nl": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Notities en foto's zijn bewijs per kamer — staat, schade of iets anders dat het vermelden waard is. Ze blijven hier en in Geschiedenis bewaard; notitietekst en bijgevoegde foto's worden beide afgedrukt op de PDF-export."
                    }
                }
            }
        },
