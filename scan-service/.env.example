# This file is a template, not a secret — .env itself is gitignored and
# must never be committed. Every value below already has a working local
# default baked into docker-compose.yml, so copying this file is optional
# for local testing. Production deployments MUST override both secrets
# below with real, unique values.

# SCAN_SERVICE_ADMIN_API_KEY — the key used to sign into /admin.
SCAN_SERVICE_ADMIN_API_KEY=

# SCAN_SERVICE_EXPORT_SECRET — HMAC key used to sign .vuuroscan bundles.
SCAN_SERVICE_EXPORT_SECRET=

# SCAN_SERVICE_APP_KEY — shared key the Vuuro Scan app sends as the
# X-Scan-App-Key header when it starts a new scan (POST /scan-sessions).
# Leave unset for local dev (no key required). Required in production, at
# least 24 random characters, e.g. `openssl rand -hex 32`. The same value
# goes into the iOS build setting SCAN_SERVICE_APP_KEY. This key ships
# inside the app and can be extracted: together with the rate limit it
# stops casual abuse of a public URL, it is not user authentication.
SCAN_SERVICE_APP_KEY=

# SCAN_SERVICE_DOMAIN — only used by docker-compose.prod.yml; leave unset
# for local dev.
SCAN_SERVICE_DOMAIN=

# SCAN_SERVICE_ENV — "development" (default) allows the weak local defaults
# above. docker-compose.prod.yml sets this to "production", which makes the
# app refuse to start at all if SCAN_SERVICE_ADMIN_API_KEY or
# SCAN_SERVICE_EXPORT_SECRET is missing or still set to its default value,
# or if SCAN_SERVICE_APP_KEY is missing or shorter than 24 characters.
SCAN_SERVICE_ENV=

# SCAN_SERVICE_DB_PATH — where the SQLite file lives. Defaults to
# data/scan_service.sqlite relative to the app; leave unset for local dev.
SCAN_SERVICE_DB_PATH=

# SCAN_SERVICE_CORS_ORIGIN — the single browser origin allowed to call this
# API cross-origin. Defaults to http://127.0.0.1:8090 (the local admin dev
# origin) if unset.
SCAN_SERVICE_CORS_ORIGIN=

# SCAN_SERVICE_PLATFORM_WEBHOOK_URL — https:// URL the
# /scan-sessions/{id}/publish-to-platform endpoint posts session payloads to.
# Leave unset to disable that endpoint entirely.
SCAN_SERVICE_PLATFORM_WEBHOOK_URL=

# SCAN_SERVICE_TRUSTED_PROXIES — comma-separated list of IPs/CIDRs allowed to
# set X-Forwarded-For for real-client-IP resolution (used for rate limiting).
# Defaults to 127.0.0.1,::1,172.16.0.0/12 (loopback + the default Docker
# bridge range, which covers the bundled Caddy container) if unset.
SCAN_SERVICE_TRUSTED_PROXIES=

# Rate limit overrides — all optional, each defaults to a safe built-in value
# if unset. See README.md's "Rate limiting" section under Known limits.
SCAN_SERVICE_RATE_LIMIT_CREATE_SESSION_MAX=
SCAN_SERVICE_RATE_LIMIT_CREATE_SESSION_WINDOW_SECONDS=
SCAN_SERVICE_RATE_LIMIT_POST_BODY_READ_MAX=
SCAN_SERVICE_RATE_LIMIT_POST_BODY_READ_WINDOW_SECONDS=

# Off-box backups (scripts/backup-offbox.sh, run nightly by scripts/nightly.sh)
# — rclone remote and bucket the newest data/backups/*.sqlite and a mirror of
# data/photos/ are copied to, e.g. r2:vuuro-scan-backups or
# b2:vuuro-scan-backups. Also used by scripts/restore-offbox.sh. The app never
# reads it.
SCAN_SERVICE_BACKUP_REMOTE=
# How many daily and weekly copies to keep on the remote (defaults 14 / 8).
SCAN_SERVICE_BACKUP_KEEP_DAILY=
SCAN_SERVICE_BACKUP_KEEP_WEEKLY=
# Optional dead man's switch for the nightly job (healthchecks.io style ping
# URL, e.g. https://hc-ping.com/<uuid>). scripts/nightly.sh pings <url>/start,
# then <url> on success or <url>/fail on any error, so a missed or failed
# backup sends an alert. Empty = no pings. Treat it as a secret.
SCAN_SERVICE_HEALTHCHECK_URL=

# Retention windows by purpose (days). Sessions older than this are deleted
# on the next retention sweep — triggered opportunistically on session
# creation (1 in 10) and by POST /admin/run-retention (call from cron or a
# scheduled job). Leave unset to disable early purge for that purpose.
# Off by default: nothing is deleted until a value is set here or an admin
# switches a purpose on in the admin page. Suggested windows: listing 90,
# check_in 365, check_out 30, renovation 365, other 180.
SCAN_SERVICE_RETENTION_DAYS_LISTING=
SCAN_SERVICE_RETENTION_DAYS_CHECK_IN=
SCAN_SERVICE_RETENTION_DAYS_CHECK_OUT=
SCAN_SERVICE_RETENTION_DAYS_RENOVATION=
SCAN_SERVICE_RETENTION_DAYS_OTHER=

# SCAN_SERVICE_PUBLIC_BASE_URL — the public origin this Scan Service is
# reachable at (e.g. https://scan.example.com). Used for absolute URLs
# returned to clients (photo uploads, publish payload, .vuuroscan export).
# Falls back to HTTP_HOST only when unset — set this in any deployment
# behind a shared proxy or CDN so a spoofed Host header can't influence
# the URLs the server hands out.
SCAN_SERVICE_PUBLIC_BASE_URL=
